{
  "appId": "com.freeai.app",
  "productName": "FreeAI",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      "deb"
    ],
    "maintainer": "FreeAI contributors <maintainers@freeai.invalid>",
    "category": "Development",
    "icon": "build/icon.png",
    "synopsis": "Unofficial desktop client for AI-assisted development",
    "executableArgs": [
      "--no-sandbox",
      "--disable-gpu"
    ]
  },
  "deb": {
    "packageCategory": "devel",
    "priority": "optional"
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] },
      "zip"
    ],
    "icon": "build/icon.png",
    "category": "public.app-category.developer-tools",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  }
}
